# Copy to .env locally. On Render, set these in Dashboard → Environment.

# Required for /api/analyze (OpenRouter — default model Qwen Plus)
OPENROUTER_API_KEY=
# Optional: model slug, e.g. qwen/qwen-plus or qwen/qwen-plus-2025-07-28
OPENROUTER_MODEL=
# Optional: OpenRouter-recommended headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=
# Optional: cap completion tokens
OPENROUTER_MAX_TOKENS=

# Optional — Google service account (Drive upload + Sheets). Use a Shared Drive folder ID.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
