# Copy to .env locally. On Render, configure these in the Environment dashboard.

# Required for internal authentication
DATABASE_URL=
DATABASE_SSL=true
# Generate a long random value (minimum 32 characters)
SESSION_SECRET=
# One-time secret used only to create the first admin account
INITIAL_SETUP_TOKEN=

# Required for CV analysis
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=
OPENROUTER_MAX_TOKENS=

# Optional Google service account integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
