# Copy to .env locally. On Render, set these in Dashboard → Environment.

# /api/analyze runs fully offline with rule-based scoring (no LLM token usage).
# No API key is required for CV analysis.

# Optional — Google service account (Drive upload + Sheets). Use a Shared Drive folder ID.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
